# ghostty +list-keybinds --default
# ghostty +show-config --default --docs | nvim

# COLORS & THEME
# Auto theme switching to match your editor setup
# Use Tokyo Night theme to match nvim better
theme = light:Catppuccin Latte,dark:Catppuccin Mocha
window-colorspace = srgb
# Keep a single window-theme setting below so window chrome behavior is unambiguous.
# window-subtitle = working-directory
# Let tmux control the window title to show session name

# FONT & DISPLAY
font-family = "FiraCode Nerd Font Mono"
font-feature = +liga
font-size = 15.5
cursor-style = bar
cursor-style-blink = true
# cursor-opacity     = 0.8
cursor-opacity = 1.0
cursor-invert-fg-bg            = true
bold-is-bright                 = true
adjust-cursor-thickness        = 3
adjust-underline-position      = 3
window-inherit-font-size       = true

font-feature = -calt
font-feature = -liga
font-feature = -dlig

# WINDOW & LAYOUT
# With separate light/dark terminal themes above, auto behaves like system here.
window-theme = auto
macos-titlebar-style = hidden
macos-titlebar-proxy-icon = visible
window-padding-x = 8
window-padding-y = 8
window-decoration = true
window-title-font-family = "FiraCode Nerd Font Mono"
macos-non-native-fullscreen = true

# KEYBINDINGS
keybind = super+r=reload_config
keybind = ctrl+enter=unbind
keybind = cmd+enter=unbind
# training wheel for old save
keybind = super+s=unbind

# SPLIT NAVIGATION
keybind = super+shift+j=goto_split:down
keybind = super+shift+k=goto_split:up
keybind = super+shift+l=goto_split:right
keybind = super+shift+h=goto_split:left

# TMUX RESIZE - Ctrl+Option+hjkl emits ESC + uppercase letter. tmux binds those
# bytes as M-H/J/K/L (tmux/bindings.conf) and nvim as <M-H> (smart-splits.lua);
# neither ever sees the modifiers, only these bytes.
#
# ESC+uppercase is deliberate, not incidental. This chord's DEFAULT encoding
# would be ESC + a control character (ctrl+h is 0x08 Backspace, ctrl+j is 0x0A
# Line Feed), and C-h/j/k/l are already pane navigation. Uppercase letters carry
# no control meaning, so they cannot collide. See ADR 021.
keybind = ctrl+alt+h=text:\x1bH
keybind = ctrl+alt+j=text:\x1bJ
keybind = ctrl+alt+k=text:\x1bK
keybind = ctrl+alt+l=text:\x1bL

# Retired alt+shift chord, explicitly ignored rather than deleted: with
# macos-option-as-alt = true, ESC+uppercase is Ghostty's DEFAULT encoding for
# alt+shift+h, so simply removing these lines would leave the old chord silently
# resizing with nothing in the config to explain why.
keybind = alt+shift+h=ignore
keybind = alt+shift+j=ignore
keybind = alt+shift+k=ignore
keybind = alt+shift+l=ignore

# QUICK TERMINAL
# #TODO make this always open in my mac screen. not the other external monitors
# keybind = global:super+ctrl+shift+alt+9=toggle_quick_terminal
quick-terminal-position = left
quick-terminal-screen = macos-menu-bar

# MISC OPTIONS
confirm-close-surface = true
quit-after-last-window-closed = false
window-save-state = always
macos-option-as-alt = true

# SCROLLING & PERFORMANCE
scrollback-limit = 10000

# SHELL
shell-integration = zsh

# `cursor` is deliberately omitted from this list: it added noticeable latency
# when opening new shells and panes. The cost of leaving it off is that OSC 133
# prompt marking is unavailable, so anything depending on prompt marks -- most
# notably `jump_to_prompt` -- cannot work. Revisit together; see the Ghostty
# section of ~/.config/docs/TODO.md.
shell-integration-features = sudo,title

# ********************** experiments **************
mouse-hide-while-typing = true
clipboard-read = allow
clipboard-write = allow
mouse-shift-capture = true
# QUESTION: what should this be?
copy-on-select = true

